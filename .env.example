# 部署配置：修改后重启。模型地址、密钥、模型名、代理在 Provider / Model 中管理。
# Web / CLI / 本地工作台共用此目录中的 umeko.db；相对路径以此 .env 所在目录为准。
# 启动参数 --data-root 可覆盖；容器部署请持久化此目录。
UMEKO_DATA_ROOT=server_data

# 浏览器入口前缀。本地 http://localhost:8000/ 保持为空。
# 生产示例：UMEKO_BASE_PATH=/doc-master/consistency/image-text
UMEKO_BASE_PATH=

# 管理面独立入口前缀，不继承 UMEKO_BASE_PATH。本地 http://localhost:9000/ 留空。
# 生产示例：UMEKO_ADMIN_BASE_PATH=/doc-master/consistency/image-text-admin
UMEKO_ADMIN_BASE_PATH=

# 机器服务的外部完整地址。路径须与 UMEKO_BASE_PATH 一致，不能带查询参数。
# 生产示例：UMEKO_PUBLIC_URL=https://example.internal/doc-master/consistency/image-text
# 本地留空，从实际访问请求推导地址；生产建议显式配置。
UMEKO_PUBLIC_URL=

# REST / MCP / A2A 共用的机器任务队列与生命周期（单进程部署）。
UMEKO_TASK_WORKERS=4
UMEKO_TASK_QUEUE_LIMIT=100
UMEKO_TASK_CALLER_LIMIT=20
UMEKO_TASK_RETENTION_SECONDS=86400
UMEKO_TMP_IDLE_SECONDS=3600
UMEKO_MACHINE_IDLE_SECONDS=900
UMEKO_TASK_TIMEOUT_SECONDS=3600

# 额外信任的模型服务 CA（PEM，可包含完整 CA 链），不是网站 HTTPS 证书。
# 生产示例：MODEL_CA_FILE=/etc/umeko/certs/company-model-ca.pem
# Windows 示例：MODEL_CA_FILE=C:/certs/company-model-ca.pem
# 相对路径以此 .env 所在目录为准；留空使用默认信任库，始终校验证书。
MODEL_CA_FILE=

# 文件下载的企业 CA（PEM；与 MODEL_CA_FILE 独立，可填写同一文件）。修改后重启。
# 相对路径以此 .env 所在目录为准；容器内需使用挂载后的路径。
# UMEKO_DOWNLOAD_CA_FILE=/etc/umeko/certs/company-files-ca.pem
UMEKO_DOWNLOAD_CA_FILE=
# 允许下载的内网主机：精确域名或 IP，逗号分隔，不含协议、端口、路径或通配符。
# 只开放这些主机的 RFC1918 / IPv6 ULA 地址；本机、链路本地及元数据地址仍禁止。
# UMEKO_DOWNLOAD_INTERNAL_HOSTS=files.company.internal,10.20.30.40
UMEKO_DOWNLOAD_INTERNAL_HOSTS=
# 暂无 CA 时可选：仅对所列精确主机跳过 TLS 证书校验，默认留空。
# 配置此项无法验证文件来源；不同时开放内网访问，不会对重定向的其他主机生效。
# UMEKO_DOWNLOAD_TLS_INSECURE_HOSTS=files.company.internal
UMEKO_DOWNLOAD_TLS_INSECURE_HOSTS=

# 可选：运行参数（管理面的运行参数可覆盖最大工具轮次）
# TEXT_MODEL_CONTEXT_WINDOW=128000
# MAX_TOOL_ITERATIONS=32
# MAX_SUBAGENT_TOOL_ITERATIONS=24

# 可选：7-Zip 可执行文件（网页与 Agent 共用；留空自动查找 7zz/7z/7za）
# 所有压缩包操作均需运行系统/容器内的 7-Zip；不使用 Python 解压。
# Linux 示例：SEVENZIP_PATH=/usr/local/bin/7zz
# SEVENZIP_PATH=C:/Program Files/7-Zip/7z.exe

# 首次启动管理员引导（无管理员账号时自动创建；已有账号使用数据库保存的密码）
# UMEKO_ADMIN_USERNAME=your-admin-name
# UMEKO_ADMIN_PASSWORD=your-admin-password
