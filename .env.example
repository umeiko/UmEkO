# 必填：主模型（OpenAI 兼容）
TEXT_MODEL_NAME=your-model
TEXT_MODEL_BASE_URL=https://api.example.com/v1
TEXT_MODEL_API_KEY=sk-xxxxxxxx

# 可选：视觉模型（启用 image_reasoning 图片分析工具）
# VISION_MODEL_NAME=your-vision-model
# VISION_MODEL_API_KEY=sk-xxxxxxxx
# VISION_MODEL_BASE_URL=https://api.example.com/v1

# 可选：模型网关代理（默认直连）
# MODEL_PROXY=http://127.0.0.1:7890

# 可选：7-Zip 路径（WebUI 解压功能，默认 C:\Program Files\7-Zip\7z.exe）
# SEVENZIP_PATH=C:\Program Files\7-Zip\7z.exe

# 可选：首次启动管理员引导（无管理员账号时自动创建）
# UMEKO_ADMIN_USERNAME=admin
# UMEKO_ADMIN_PASSWORD=change-me-please
