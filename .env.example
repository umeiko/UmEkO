# 文本模型（主 Agent）
TEXT_MODEL_NAME=your-text-model-name
TEXT_MODEL_API_KEY=sk-you...-key
TEXT_MODEL_BASE_URL=https://api.example.com/v1
# 主 Agent 上下文窗口（token）。用于近似占用展示与压缩参考。
TEXT_MODEL_CONTEXT_WINDOW=128000

# 文本模型是否具备原生多模态能力（true/false）。
# true 后用户可直接贴图、read_image 工具可用。不具备视觉能力的模型请保持 false。
TEXT_MODEL_VISION=false

# 多模态模型（图片理解；可选——不配置时 image_reasoning/ocr_image 不可用，
# check 管线会拒绝执行而不是臆造审查标准）
VISION_MODEL_NAME=your-vision-model-name
VISION_MODEL_API_KEY=sk-you...-key
VISION_MODEL_BASE_URL=https://api.example.com/v1

# 模型 API 代理（文本和视觉模型共用）。默认留空并忽略系统代理，直接访问 BASE_URL；
# 只有模型 API 确实需要代理时才填写，例如 http://127.0.0.1:7890。
# MODEL_PROXY=

# Agent 行为
# 主 Agent 单次请求最多连续执行多少个 function-calling 回合
MAX_TOOL_ITERATIONS=8
# 子 Agent 最多连续执行多少个 function-calling 回合；一回合可能包含多个工具调用。
# 某些内网模型每回合只调用一个工具，批量/多检查项质检可按需提高（如 48）。
MAX_SUBAGENT_TOOL_ITERATIONS=24

# Skill 包目录（默认 ./skills）
# UMEKO_SKILL_DIR=
